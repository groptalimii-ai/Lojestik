# ---------- Database ----------
POSTGRES_USER=freightai
POSTGRES_PASSWORD=change_me
POSTGRES_DB=freightai
DATABASE_URL=postgresql+asyncpg://freightai:change_me@db:5432/freightai

# ---------- Redis ----------
REDIS_URL=redis://redis:6379/0

# ---------- Telegram ----------
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# ---------- AI ----------
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-4-6

# ---------- Backend ----------
BACKEND_URL=http://backend:8000
JWT_SECRET=change_me_to_a_long_random_string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
# Shared ONLY between the bot process and the backend. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Must be identical in both services' .env, and never exposed to users.
BOT_SERVICE_SECRET=change_me_to_a_long_random_string
ENVIRONMENT=development

# ---------- Business ----------
CAPITAL_TARGET_SAR=80000

# ---------- Rate limiting (per Telegram/user account, per day) ----------
RATE_LIMIT_AI_EXTRACT_PER_DAY=30
RATE_LIMIT_LOADS_PER_DAY=20
RATE_LIMIT_CARRIER_ACTIONS_PER_DAY=20
RATE_LIMIT_DEFAULT_PER_DAY=100
RATE_LIMIT_PRICING_PER_DAY=5
RATE_LIMIT_INTAKE_PER_DAY=1000

# ---------- Google Maps (FROZEN until commercial launch) ----------
# Both must be set to activate -- either left as-is means zero network
# calls to Google, ever. See README "Google Maps Integration".
GOOGLE_MAPS_ENABLED=false
GOOGLE_MAPS_API_KEY=
